# Frontend Environment Variables

# API Configuration
# The base URL for the ClickUp Reporter API
# Development: http://localhost:8080
# Production: https://your-api-gateway-url.amazonaws.com
VITE_API_BASE_URL=http://localhost:5000

# Development Configuration
# Set to true to enable development mode features
VITE_DEV_MODE=true

# Optional: Enable debug logging in development
VITE_DEBUG=false

# Optional: Application version (automatically set by build process)
# VITE_APP_VERSION=1.0.0

# Optional: Environment name for display
VITE_ENVIRONMENT=development